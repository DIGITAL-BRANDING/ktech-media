# Supabase project URL and publishable key. Never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public identity is configurable so a new approved brand can be applied in one place.
NEXT_PUBLIC_SITE_NAME=K-TECH MEDIA NETWORK
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional live stream embed URL (trusted editorial setting).
NEXT_PUBLIC_LIVE_STREAM_URL=

# Server-only key for newsletter and Web Push subscription writes. Never add NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Newsletter confirmation/unsubscribe token signer (generate a random value of at least 32 chars).
NEWSLETTER_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Resend email delivery
RESEND_API_KEY=re_replace_with_resend_api_key
NEWSLETTER_FROM_EMAIL=K-TECH MEDIA NETWORK <news@k-tech.com.ng>

# Web Push VAPID (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:news@k-tech.com.ng
